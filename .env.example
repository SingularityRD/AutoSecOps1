# --- Shared env vars ---
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=autosecops
COMPOSE_BAKE=true

# --- Network configuration ---
PUBLIC_APP_PORT=80
PUBLIC_APP_URL=http://localhost:${PUBLIC_APP_PORT}
PUBLIC_API_URL=${PUBLIC_APP_URL}/api
INTERNAL_API_URL=http://api:8000

# -- Caddy env vars ---
BASE_DOMAIN=:${PUBLIC_APP_PORT}
ADDRESS=0.0.0.0

# --- Frontend env vars ---
# `env.sh` sets these together with AUTOSECOPS__APP_ENV. Self-hosted installs run
# in production mode; answer "n" to the env.sh production prompt only for local
# development.
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
# The frontend app URL
NEXT_PUBLIC_APP_URL=${PUBLIC_APP_URL}
# Allows the browser to communicate with the backend
NEXT_PUBLIC_API_URL=${PUBLIC_API_URL}
# Allows the frontend server (inside docker) to communicate with the backend server (inside docker)
NEXT_SERVER_API_URL=${INTERNAL_API_URL}

# --- App and DB env vars ---
# One of `development`, `staging`, or `production`
AUTOSECOPS__APP_ENV=production
# Values starting with `change-me-` are placeholders. `env.sh` replaces them
# with generated secrets, and `./env.sh --check` refuses a .env that still
# contains one. Never deploy with a placeholder value.
# Used to encrypt/decrypt sensitive keys in the database
# Can be generated using `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
AUTOSECOPS__DB_ENCRYPTION_KEY=change-me-db-fernet-key
# Used to authenticate with AutoSecOps services
# Can be generated using `openssl rand -hex 32`
AUTOSECOPS__SERVICE_KEY=change-me-service-key
# Used to generate private webhook URLs
# Can be generated using `openssl rand -hex 32`
AUTOSECOPS__SIGNING_SECRET=change-me-signing-secret
# API Service URL
AUTOSECOPS__API_URL=${INTERNAL_API_URL}
# Root path to deal with extra path prefix behind the reverse proxy
AUTOSECOPS__API_ROOT_PATH=/api
# This the public URL for the frontend
AUTOSECOPS__PUBLIC_APP_URL=${PUBLIC_APP_URL}
# This is the public URL for incoming webhooks
# If you wish to expose your webhooks to the internet, you can use a tunneling service like ngrok.
# If using ngrok, run `ngrok http --domain=INSERT_STATIC_NGROK_DOMAIN_HERE 8001`
# to start ngrok and update this with the forwarding URL
AUTOSECOPS__PUBLIC_API_URL=${PUBLIC_API_URL}
# CORS (comma-separated string of allowed origins)
AUTOSECOPS__ALLOW_ORIGINS=${PUBLIC_APP_URL}
# Invitation email via SMTP. Set every value to enable delivery. For Resend,
# use smtp.resend.com:587, user "resend", and an API key as the password.
AUTOSECOPS__SMTP_HOST=
AUTOSECOPS__SMTP_PORT=587
AUTOSECOPS__SMTP_USER=
AUTOSECOPS__SMTP_PASSWORD=
# Sender, e.g. "AutoSecOps <no-reply@your-verified-domain.com>"
AUTOSECOPS__EMAIL_FROM=
# Postgres SSL mode. The bundled `postgres_db` container is only reachable on
# the internal Compose network and does not serve TLS, so it uses `disable`.
# Use `require` (or `verify-full`) for any external or managed database.
AUTOSECOPS__DB_SSLMODE=disable

# --- Postgres ---
AUTOSECOPS__POSTGRES_USER=postgres
# Generated by env.sh in production mode.
AUTOSECOPS__POSTGRES_PASSWORD=change-me-postgres-password
AUTOSECOPS__DB_URI=postgresql+psycopg://${AUTOSECOPS__POSTGRES_USER}:${AUTOSECOPS__POSTGRES_PASSWORD}@postgres_db:5432/postgres
# Password of the non-owner `autosecops_app` role the services connect as, so
# tenant row-level security applies. Migrations create the role and set this
# password. Generated by env.sh; leave empty to keep the services on the owner
# role above, which bypasses row-level security.
AUTOSECOPS__DB_RUNTIME_PASSWORD=change-me-runtime-password

# --- Authentication ---

# First user to promote to superadmin
AUTOSECOPS__AUTH_SUPERADMIN_EMAIL=

# One or more comma-separated values from `basic`, `oidc`, `saml`
AUTOSECOPS__AUTH_TYPES=basic
# Email domains allowed to sign up and sign in, comma-separated, e.g.
# `example.com,example.org`. Blank allows every domain, so anyone who can reach
# the login page can register with basic auth. Set this in production.
AUTOSECOPS__AUTH_ALLOWED_DOMAINS=
AUTOSECOPS__AUTH_MIN_PASSWORD_LENGTH=12

# OIDC / OAuth
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email"

# MCP server (external IDE integrations)
AUTOSECOPS_MCP__FILE_TRANSFER_URL_EXPIRY_SECONDS=300
AUTOSECOPS_MCP__STARTUP_MAX_ATTEMPTS=3
AUTOSECOPS_MCP__STARTUP_RETRY_DELAY_SECONDS=2

# Legacy aliases (still supported)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Used for password reset and email verification tokens
# Can be generated using `openssl rand -hex 32`
USER_AUTH_SECRET=change-me-user-auth-secret

# SAML SSO settings
SAML_IDP_METADATA_URL=

# --- Temporal ---
TEMPORAL__CLUSTER_URL=temporal:7233
TEMPORAL__CLUSTER_QUEUE=autosecops-task-queue
TEMPORAL__CLUSTER_NAMESPACE=default
TEMPORAL__POSTGRES_USER=temporal
# Generated by env.sh in production mode.
TEMPORAL__POSTGRES_PASSWORD=change-me-temporal-postgres-password
# Pinned Temporal Web UI image tag. Keep in step with the Fargate default.
TEMPORAL__UI_VERSION=2.43.3
# Workflow history retention for the Temporal namespace, applied when the
# namespace is first created. Minimum 1 day. See
# https://docs.singularityrd.com/self-hosting/temporal-retention
TEMPORAL__DEFAULT_NAMESPACE_RETENTION=24h
# Leave empty if not using Temporal Cloud
TEMPORAL__API_KEY=
# Thread-pool size shared by the DSL and agent workflow workers. Lower this on
# small CPU allocations to reduce GIL contention.
TEMPORAL__THREADPOOL_MAX_WORKERS=100
# DSL worker activity and workflow-task concurrency.
TEMPORAL__MAX_CONCURRENT_ACTIVITIES=100
TEMPORAL__MAX_CONCURRENT_WORKFLOW_TASKS=100
# Agent workflow worker activity admission.
AUTOSECOPS__AGENT_MAX_CONCURRENT_ACTIVITIES=100
# Agent execution worker activity admission.
AUTOSECOPS__AGENT_EXECUTOR_MAX_CONCURRENT_ACTIVITIES=8

# --- Executor ---
AUTOSECOPS__EXECUTOR_BACKEND=direct
AUTOSECOPS__LITELLM_BASE_URL=http://litellm:4000
# Executor concurrency tuning. Lower these on small CPU allocations.
AUTOSECOPS__EXECUTOR_MAX_CONCURRENT_ACTIVITIES=32
AUTOSECOPS__EXECUTOR_THREADPOOL_MAX_WORKERS=32
# Max parallel iterations within a single action's `for_each` loop.
AUTOSECOPS__EXECUTOR_FOR_EACH_MAX_CONCURRENCY=4

# --- Workflow Artifacts ---
# Retention period in days for workflow artifacts in blob storage.
# Objects older than this will be automatically deleted via S3 lifecycle rules.
# Set to 0 to disable automatic expiration.
# Default: 30 days (matches Temporal Cloud workflow history retention).
AUTOSECOPS__WORKFLOW_ARTIFACT_RETENTION_DAYS=30

# --- Blob storage ---
AUTOSECOPS__BLOB_STORAGE_BUCKET_WORKFLOW=autosecops-workflow
AUTOSECOPS__BLOB_STORAGE_BUCKET_ATTACHMENTS=autosecops-attachments
AUTOSECOPS__BLOB_STORAGE_BUCKET_REGISTRY=autosecops-registry
AUTOSECOPS__BLOB_STORAGE_BUCKET_AGENT=autosecops-agent
# Verify TLS certificates when connecting to blob storage (S3/MinIO).
# Set to false for self-hosted S3-compatible storage with self-signed/absent certs.
AUTOSECOPS__BLOB_STORAGE_SSL_VERIFY=true

# --- MinIO ---
MINIO_ROOT_USER=minio
# Generated by env.sh in production mode.
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Password the bundled Redis (Valkey) requires. Generated by env.sh. The
# services send it when REDIS_URL carries no credentials of its own; a password
# in REDIS_URL takes precedence, e.g. for an external Redis.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# --- Cloud only ---
# AutoSecOps Cloud only, please ignore if self-hosted:
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_DISABLE_SESSION_RECORDING=true

# --- Externalization ---
# Store large action results and triggers in blob storage instead of Temporal history.
AUTOSECOPS__RESULT_EXTERNALIZATION_ENABLED=true
# Store large collections as chunked manifests in blob storage.
AUTOSECOPS__COLLECTION_MANIFESTS_ENABLED=true
# Threshold in bytes above which payloads are externalized to blob storage.
AUTOSECOPS__RESULT_EXTERNALIZATION_THRESHOLD_BYTES=128000

# --- Local registry ---
# Enable this only for local-registry development. Leave disabled for normal remote/builtin registry use.
AUTOSECOPS__LOCAL_REPOSITORY_ENABLED=false
# Absolute host path to the local registry package for Docker bind mounts.
AUTOSECOPS__LOCAL_REPOSITORY_PATH=/absolute/path/to/internal-registry
# Keep the default unless you need extra import paths in the executor containers.
PYTHONPATH=/home/apiuser/.local:/app/local_registry

# --- Enterprise ---
# Signed license key from SingularityRD (info@singularityrd.com). Paid
# entitlements on self-hosted deployments come only from this key.
AUTOSECOPS__LICENSE_KEY=
# Feature flags (comma-separated list). Flags do not grant paid entitlements.
AUTOSECOPS__FEATURE_FLAGS=""
AUTOSECOPS__EE_MULTI_TENANT=false
