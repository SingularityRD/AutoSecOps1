# Authoritative resource baseline for `just cluster loadtest`.
#
# A matrix CSV may use any AUTOSECOPS__LOADTEST_* name declared here as a column.
# Empty cells and omitted resource columns inherit these values. Add new
# Compose resource dimensions here before exposing them in a matrix; unknown
# CSV columns are rejected to catch typos.
#
# Do not copy or source this file for a normal run. Put per-case overrides in
# the CSV and let the matrix orchestrator pass the effective configuration to
# both the cluster wrapper and metric collector.
#
# CPU and memory values use Docker Compose syntax. A value of 0 is unlimited.
# The baseline constrains only postgres_db; override any other pair in a CSV
# row to make that service a resource dimension.

AUTOSECOPS__LOADTEST_CADDY_CPUS=0
AUTOSECOPS__LOADTEST_CADDY_MEMORY=0
AUTOSECOPS__LOADTEST_API_CPUS=0
AUTOSECOPS__LOADTEST_API_MEMORY=0
AUTOSECOPS__LOADTEST_WORKER_CPUS=0
AUTOSECOPS__LOADTEST_WORKER_MEMORY=0
AUTOSECOPS__LOADTEST_EXECUTOR_CPUS=0
AUTOSECOPS__LOADTEST_EXECUTOR_MEMORY=0
AUTOSECOPS__LOADTEST_AGENT_WORKER_CPUS=0
AUTOSECOPS__LOADTEST_AGENT_WORKER_MEMORY=0
AUTOSECOPS__LOADTEST_LITELLM_CPUS=0
AUTOSECOPS__LOADTEST_LITELLM_MEMORY=0
AUTOSECOPS__LOADTEST_AGENT_EXECUTOR_CPUS=0
AUTOSECOPS__LOADTEST_AGENT_EXECUTOR_MEMORY=0
AUTOSECOPS__LOADTEST_MCP_CPUS=0
AUTOSECOPS__LOADTEST_MCP_MEMORY=0
AUTOSECOPS__LOADTEST_UI_CPUS=0
AUTOSECOPS__LOADTEST_UI_MEMORY=0
AUTOSECOPS__LOADTEST_POSTGRES_DB_CPUS=1.0
AUTOSECOPS__LOADTEST_POSTGRES_DB_MEMORY=1g
AUTOSECOPS__LOADTEST_MIGRATIONS_CPUS=0
AUTOSECOPS__LOADTEST_MIGRATIONS_MEMORY=0
AUTOSECOPS__LOADTEST_TEMPORAL_POSTGRES_DB_CPUS=0
AUTOSECOPS__LOADTEST_TEMPORAL_POSTGRES_DB_MEMORY=0
AUTOSECOPS__LOADTEST_TEMPORAL_CPUS=0
AUTOSECOPS__LOADTEST_TEMPORAL_MEMORY=0
AUTOSECOPS__LOADTEST_TEMPORAL_NUM_HISTORY_SHARDS=512
AUTOSECOPS__LOADTEST_TEMPORAL_UI_CPUS=0
AUTOSECOPS__LOADTEST_TEMPORAL_UI_MEMORY=0
AUTOSECOPS__LOADTEST_MINIO_CPUS=0
AUTOSECOPS__LOADTEST_MINIO_MEMORY=0
AUTOSECOPS__LOADTEST_REDIS_CPUS=0
AUTOSECOPS__LOADTEST_REDIS_MEMORY=0

# Optional PgDog transaction pool selected with `just cluster loadtest
# --pgdog`. PgDog recommends two Tokio workers per vCPU; pgdog.toml uses two
# workers for this one-vCPU profile.
AUTOSECOPS__LOADTEST_PGDOG_CPUS=1
AUTOSECOPS__LOADTEST_PGDOG_MEMORY=512m
AUTOSECOPS__LOADTEST_PGDOG_POOL_SIZE=16
AUTOSECOPS__LOADTEST_PGDOG_MIN_POOL_SIZE=1
AUTOSECOPS__LOADTEST_PGDOG_WORKER_POOL_SIZE=6
AUTOSECOPS__LOADTEST_PGDOG_EXECUTOR_POOL_SIZE=16
AUTOSECOPS__LOADTEST_PGDOG_AUX_POOL_SIZE=2
AUTOSECOPS__LOADTEST_PGDOG_LOG_LEVEL=info

# PostgreSQL-under-test settings.
AUTOSECOPS__LOADTEST_POSTGRES_DB_PIDS=256
AUTOSECOPS__LOADTEST_POSTGRES_MAX_CONNECTIONS=50
AUTOSECOPS__LOADTEST_POSTGRES_SHARED_BUFFERS=128MB

# Workflow worker scheduling and Temporal worker throughput.
AUTOSECOPS__LOADTEST_DSL_SCHEDULER_MAX_PENDING_TASKS=64
AUTOSECOPS__LOADTEST_CHILD_WORKFLOW_DISPATCH_WINDOW=16
AUTOSECOPS__LOADTEST_TEMPORAL_THREADPOOL_MAX_WORKERS=100
AUTOSECOPS__LOADTEST_TEMPORAL_MAX_CONCURRENT_ACTIVITIES=100
AUTOSECOPS__LOADTEST_TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=100

# Executor throughput. Leave the worker-pool size blank to use its backend
# default. The for_each value is a per-action bound.
AUTOSECOPS__LOADTEST_EXECUTOR_REPLICAS=1
AUTOSECOPS__LOADTEST_EXECUTOR_MAX_CONCURRENT_ACTIVITIES=8
AUTOSECOPS__LOADTEST_EXECUTOR_FOR_EACH_MAX_CONCURRENCY=4
AUTOSECOPS__LOADTEST_EXECUTOR_THREADPOOL_MAX_WORKERS=

# LiteLLM defaults to two worker processes in development. The load-test
# profile uses one so its per-process SQLAlchemy pool is counted exactly once.
AUTOSECOPS__LOADTEST_LITELLM_NUM_WORKERS=1

# Deployment-wide database-pool budget. Each service process owns independent
# main and authentication SQLAlchemy pools. This one-replica direct-PostgreSQL
# baseline counts both pool ceilings, uses no overflow, and totals 42
# application connections beneath max_connections=50 with an eight-connection
# operational reserve.
AUTOSECOPS__LOADTEST_API_DB_POOL_SIZE=5
AUTOSECOPS__LOADTEST_API_DB_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_API_DB_AUTH_POOL_SIZE=2
AUTOSECOPS__LOADTEST_API_DB_AUTH_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_WORKER_DB_POOL_SIZE=5
AUTOSECOPS__LOADTEST_WORKER_DB_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_WORKER_DB_AUTH_POOL_SIZE=4
AUTOSECOPS__LOADTEST_WORKER_DB_AUTH_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_EXECUTOR_DB_POOL_SIZE=9
AUTOSECOPS__LOADTEST_EXECUTOR_DB_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_EXECUTOR_DB_AUTH_POOL_SIZE=5
AUTOSECOPS__LOADTEST_EXECUTOR_DB_AUTH_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_AGENT_WORKER_DB_POOL_SIZE=2
AUTOSECOPS__LOADTEST_AGENT_WORKER_DB_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_AGENT_WORKER_DB_AUTH_POOL_SIZE=1
AUTOSECOPS__LOADTEST_AGENT_WORKER_DB_AUTH_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_MCP_DB_POOL_SIZE=2
AUTOSECOPS__LOADTEST_MCP_DB_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_MCP_DB_AUTH_POOL_SIZE=1
AUTOSECOPS__LOADTEST_MCP_DB_AUTH_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_LITELLM_DB_POOL_SIZE=2
AUTOSECOPS__LOADTEST_LITELLM_DB_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_LITELLM_DB_AUTH_POOL_SIZE=1
AUTOSECOPS__LOADTEST_LITELLM_DB_AUTH_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_AGENT_EXECUTOR_DB_POOL_SIZE=2
AUTOSECOPS__LOADTEST_AGENT_EXECUTOR_DB_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_AGENT_EXECUTOR_DB_AUTH_POOL_SIZE=1
AUTOSECOPS__LOADTEST_AGENT_EXECUTOR_DB_AUTH_MAX_OVERFLOW=0
AUTOSECOPS__LOADTEST_DB_POOL_TIMEOUT=10
AUTOSECOPS__LOADTEST_DB_POOL_RECYCLE=600
