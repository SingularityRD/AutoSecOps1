# Git
.git
.gitignore

# Frontend build artifacts and dependencies
frontend/.next
frontend/node_modules

# Deployments (terraform, etc)
deployments
# The production image ships the Fargate Terraform stack (see Dockerfile), so
# keep its sources but never local Terraform state, plugins, or variable files.
!deployments/fargate
deployments/fargate/**/.terraform
deployments/fargate/**/.terraform.lock.hcl
deployments/fargate/**/*.tfstate
deployments/fargate/**/*.tfstate.*
deployments/fargate/**/*.tfvars
deployments/fargate/**/*.tfvars.json
deployments/fargate/**/*.tfplan
deployments/fargate/**/tfplan
deployments/fargate/**/crash*.log
deployments/fargate/**/override.tf
deployments/fargate/**/override.tf.json
deployments/fargate/**/*_override.tf
deployments/fargate/**/*_override.tf.json
deployments/fargate/**/.terraformrc
deployments/fargate/**/terraform.rc

# Python
__pycache__
*.py[cod]
*.pyo
.venv
venv
.env
*.egg-info
dist
.mypy_cache
.pytest_cache
.ruff_cache

# Docs text is embedded in the Workspace Chat adapter; omit only heavy images.
docs/img
img

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
.coverage
htmlcov
.tox

# Local development
*.log
*.tmp
.trees
