# AutoSecOps local evaluation lab settings.
#
# Copy with `./deployments/lab/lab.sh env`, which writes .env.lab next to this
# file and replaces every `change-me-` value with a random local-only secret.
# These credentials protect throwaway lab services bound to 127.0.0.1. Never
# reuse them anywhere else.

# Compose network of the running AutoSecOps stack. Docker Compose names it
# <COMPOSE_PROJECT_NAME>_core; the default project name is `autosecops`.
AUTOSECOPS_CORE_NETWORK=autosecops_core

LAB_TZ=UTC

# --- MISP (profile: misp) ---
LAB_MISP_PORT=8443
LAB_MISP_ADMIN_EMAIL=admin@lab.local
LAB_MISP_ADMIN_ORG=LAB
# Login password for the MISP web UI. Needs 12+ characters with upper case,
# lower case, and a digit or symbol.
LAB_MISP_ADMIN_PASSWORD=change-me-misp-admin-password
# 40-character automation key, `openssl rand -hex 20`. Use it as MISP_API_KEY.
LAB_MISP_ADMIN_KEY=change-me-misp-admin-key
LAB_MISP_ENCRYPTION_KEY=change-me-misp-encryption-key
LAB_MISP_DB_PASSWORD=change-me-misp-db-password
LAB_MISP_DB_ROOT_PASSWORD=change-me-misp-db-root-password
LAB_MISP_REDIS_PASSWORD=change-me-misp-redis-password
LAB_MISP_DISABLE_PRINTING_PLAINTEXT_CREDENTIALS=true

# --- OpenSearch (profile: opensearch) ---
LAB_OPENSEARCH_PORT=9201
LAB_OPENSEARCH_DASHBOARDS_PORT=5602
LAB_OPENSEARCH_HEAP=512m
# Password for the `admin` user. Needs upper case, lower case, a digit, and a
# symbol.
LAB_OPENSEARCH_ADMIN_PASSWORD=change-me-opensearch-admin-password

# --- Wazuh (profile: wazuh) ---
LAB_WAZUH_API_PORT=55000
LAB_WAZUH_INDEXER_PORT=9202
LAB_WAZUH_DASHBOARD_PORT=5443
LAB_WAZUH_INDEXER_HEAP=1g
# Password for the `wazuh-wui` API user, applied on the manager's first start.
# Needs 8-64 characters with upper case, lower case, a digit, and a symbol.
LAB_WAZUH_API_PASSWORD=change-me-wazuh-api-password

# --- FleetDM (profile: fleet) ---
LAB_FLEET_PORT=8412
LAB_FLEET_SERVER_TLS=false
LAB_FLEET_MYSQL_PASSWORD=change-me-fleet-mysql-password
LAB_FLEET_MYSQL_ROOT_PASSWORD=change-me-fleet-mysql-root-password

# --- Mailpit (profile: mailpit) ---
LAB_MAILPIT_UI_PORT=8025
LAB_MAILPIT_SMTP_AUTH_ACCEPT_ANY=true
LAB_MAILPIT_SMTP_AUTH_ALLOW_INSECURE=true

# --- Ollama container (profile: ollama) ---
LAB_OLLAMA_PORT=11435
LAB_OLLAMA_CONTEXT_LENGTH=32768
