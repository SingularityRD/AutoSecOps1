# High-availability profile for the AutoSecOps Fargate stack.
#
# Opt-in: these settings roughly double the RDS and ElastiCache cost and run
# at least two tasks of every stateless service. Copy the file next to
# main.tf, review it, and pass it to Terraform:
#
#   cp examples/ha.tfvars.example ha.tfvars
#   terraform apply -var-file=ha.tfvars
#
# ECS spreads the tasks of each service across the private subnets' Availability
# Zones, so two tasks survive the loss of one zone.

# Stateless services: at least two tasks each.
api_desired_count               = 2
worker_desired_count            = 2
executor_desired_count          = 2
agent_worker_desired_count      = 2
agent_executor_desired_count    = 2
background_worker_desired_count = 2
mcp_desired_count               = 2
litellm_desired_count           = 2

# PostgreSQL: a synchronous standby in another Availability Zone.
rds_multi_az = true

# Redis: a replica in another Availability Zone with automatic failover.
redis_num_cache_clusters = 2

# Keep task logs for a year in CloudWatch Logs.
log_retention_in_days = 365
