# Supply-chain cooldown: only resolve releases published at least 7 days ago.
minimum-release-age=10080
# Security exception inside the cooldown (GHSA-mrwp-f3q8-3g9p, fixed in 1.16.2,
# released 2026-10-25). Remove on or after 2026-11-02, once it is 7 days old.
minimum-release-age-exclude[]=follow-redirects
# Security exceptions inside the cooldown: glob 14.0.2 (GHSA-3g3m-2fjr-6pw4) and
# minimatch 11.0.1 (GHSA-g3hv-75wg-m249), released 2026-10-27, plus the new
# dependencies they pull in. Pinned to exact versions so only these releases
# skip the cooldown. Remove on or after 2026-11-04, once they are 7 days old.
minimum-release-age-exclude[]=glob@14.0.2
minimum-release-age-exclude[]=minimatch@11.0.1
minimum-release-age-exclude[]=path-scurry@3.0.0
minimum-release-age-exclude[]=@isaacs/nonrecursive-glob-match@1.0.1
