# Supply-chain cooldown: only resolve releases published at least 7 days ago.
minimum-release-age=10080
# Security exception inside the cooldown (GHSA-mrwp-f3q8-3g9p, fixed in 1.16.2,
# released 2026-10-25). Remove on or after 2026-11-02, once it is 7 days old.
minimum-release-age-exclude[]=follow-redirects
