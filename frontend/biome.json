{
  "$schema": "https://biomejs.dev/schemas/2.0.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true,
    "includes": [
      "**",
      "!**/cache",
      "!**/.cache",
      "!**/package.json",
      "!**/package-lock.json",
      "!**/public",
      "!**/CHANGELOG.md",
      "!**/.yarn",
      "!**/dist",
      "!**/node_modules",
      "!**/.next",
      "!**/build",
      "!**/.contentlayer"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "a11y": {
        "recommended": true,
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "Checkbox",
              "Input",
              "RadioGroupItem",
              "Switch",
              "Textarea"
            ]
          }
        }
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noPrecisionLoss": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "warn",
        "useJsxKeyInIterable": "off"
      },
      "style": {
        "noNamespace": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tanstack/react-query": "Import React Query through @/lib/query so mutations use the shared error pipeline."
            }
          }
        },
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "off",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noUnsafeDeclarationMerging": "error"
      }
    },
    "includes": [
      "**",
      "!dist/*",
      "!**/.cache",
      "!**/public",
      "!**/.next/**",
      "!**/node_modules",
      "!**/*.esm.js",
      "!src/client/**"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": {
    "formatter": {
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/client/**"],
      "files": {
        "maxSize": 4194304
      }
    },
    {
      "includes": ["*.ts", "*.tsx"]
    },
    {
      "includes": ["*.ts", "*.tsx", "*.mts", "*.cts"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "error"
          },
          "correctness": {
            "noConstAssign": "off",
            "noGlobalObjectCalls": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noInvalidConstructorSuper": "off",
            "noSetterReturn": "off",
            "noUndeclaredVariables": "off",
            "noUnreachable": "off",
            "noUnreachableSuper": "off"
          },
          "style": {
            "useConst": "error"
          },
          "suspicious": {
            "noDuplicateClassMembers": "off",
            "noDuplicateObjectKeys": "off",
            "noDuplicateParameters": "off",
            "noFunctionAssign": "off",
            "noImportAssign": "off",
            "noRedeclare": "off",
            "noUnsafeNegation": "off",
            "noVar": "error",
            "useGetterReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/agents/agent-model-combobox.tsx",
        "src/components/agents/agent-preset-rail-tools.tsx",
        "src/components/agents/agent-presets-builder.tsx",
        "src/components/agents/agents-dashboard.tsx",
        "src/components/agents/create-agent-dialog.tsx",
        "src/components/ai-elements/file-tree.tsx",
        "src/components/builder/canvas/action-node-effect.tsx",
        "src/components/builder/canvas/canvas-toolbar.tsx",
        "src/components/builder/canvas/custom-handle.tsx",
        "src/components/builder/canvas/trigger-node.tsx",
        "src/components/builder/events/workflow-rerun-dialog.tsx",
        "src/components/builder/panel/action-panel-fields.tsx",
        "src/components/builder/panel/action-panel.tsx",
        "src/components/builder/panel/workflow-panel.tsx",
        "src/components/cases/case-attachments-section.tsx",
        "src/components/cases/case-comment-agent.tsx",
        "src/components/cases/case-comment-editor.tsx",
        "src/components/cases/case-description-editor.tsx",
        "src/components/cases/case-item.tsx",
        "src/components/cases/case-panel-custom-fields.tsx",
        "src/components/cases/case-panel-fields-group.tsx",
        "src/components/cases/case-panel-view.tsx",
        "src/components/cases/case-sub-cases.tsx",
        "src/components/cases/cases-header.tsx",
        "src/components/cases/multiselect-case-filters.tsx",
        "src/components/chat/approval-request-part.tsx",
        "src/components/chat/chat-history-dropdown.tsx",
        "src/components/dashboard/folder-move-dialog.tsx",
        "src/components/dashboard/workflow-move-dialog.tsx",
        "src/components/events/workflow-events-list.tsx",
        "src/components/forms/form-config-tab.tsx",
        "src/components/forms/widgets/file.tsx",
        "src/components/forms/widgets/user.tsx",
        "src/components/inbox/runs-table.tsx",
        "src/components/json-viewer-compact.tsx",
        "src/components/json-viewer.tsx",
        "src/components/license/license-expiry-banner.tsx",
        "src/components/organization/invite-member-dialog.tsx",
        "src/components/organization/org-members-table.tsx",
        "src/components/organization/org-vcs-github-manual-form.tsx",
        "src/components/organization/rbac-list-item.tsx",
        "src/components/organization/service-accounts-manager.tsx",
        "src/components/registry/action-listbox.tsx",
        "src/components/service-account-json-uploader.tsx",
        "src/components/skills/editor-panel.tsx",
        "src/components/skills/skills-dashboard.tsx",
        "src/components/skills/upload-skill-dialog.tsx",
        "src/components/tables/ag-grid-table.tsx",
        "src/components/tables/cell-editors.tsx",
        "src/components/tables/table-rows-grid.tsx",
        "src/components/tables/tables-dashboard.tsx",
        "src/components/tags-input.tsx",
        "src/components/tiptap-node/image-upload-node/image-upload-node.tsx",
        "src/components/tiptap-ui-primitive/button/button.tsx",
        "src/components/tiptap-ui-primitive/toolbar/toolbar.tsx",
        "src/components/tiptap-ui/blockquote-button/blockquote-button.tsx",
        "src/components/tiptap-ui/code-block-button/code-block-button.tsx",
        "src/components/tiptap-ui/color-highlight-button/color-highlight-button.tsx",
        "src/components/tiptap-ui/color-highlight-popover/color-highlight-popover.tsx",
        "src/components/tiptap-ui/heading-button/heading-button.tsx",
        "src/components/tiptap-ui/heading-dropdown-menu/heading-dropdown-menu.tsx",
        "src/components/tiptap-ui/image-upload-button/image-upload-button.tsx",
        "src/components/tiptap-ui/link-popover/link-popover.tsx",
        "src/components/tiptap-ui/list-button/list-button.tsx",
        "src/components/tiptap-ui/list-dropdown-menu/list-dropdown-menu.tsx",
        "src/components/tiptap-ui/mark-button/mark-button.tsx",
        "src/components/tiptap-ui/text-align-button/text-align-button.tsx",
        "src/components/tiptap-ui/undo-redo-button/undo-redo-button.tsx",
        "src/components/toggleable-dropdown-item.tsx",
        "src/components/tools/tool-picker-dialog.tsx",
        "src/components/ui/carousel.tsx",
        "src/components/ui/input-group.tsx",
        "src/components/workflow-runs/workflow-run-item.tsx",
        "src/components/workflow-runs/workflow-runs-layout.tsx",
        "src/components/workspace-chat/artifacts/artifact-tabs.tsx",
        "src/components/workspace-sync/git-sync-action-bar.tsx",
        "src/components/workspace-sync/git-sync-commit-picker.tsx",
        "src/components/workspace-sync/git-sync-connection.tsx",
        "src/components/workspace-sync/git-sync-pull.tsx",
        "src/components/workspaces/create-credential-dialog.tsx",
        "src/components/workspaces/edit-workspace-secret.tsx",
        "src/components/workspaces/secret-source-picker.tsx",
        "src/components/workspaces/workspace-credentials-inventory.tsx",
        "src/components/workspaces/workspaces-admin-button.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "warn",
            "useKeyWithClickEvents": "warn",
            "useSemanticElements": "warn"
          }
        }
      }
    },
    {
      "includes": ["tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "recommended": false,
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/query.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
